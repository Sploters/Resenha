{
  "name": "resenha-desktop",
  "version": "1.0.25",
  "description": "Resenha Desktop — cliente do seu servidor Resenha",
  "main": "main.js",
  "author": "Resenha",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "npm run native && node make-icon.mjs && electron-builder --win",
    "native": "node build-native.mjs"
  },
  "build": {
    "appId": "br.resenha.app",
    "productName": "Resenha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "splash.html",
      "build/icon.png",
      "build/tray.png",
      "remote.js",
      "build/icon.ico",
      "native.js",
      "clipflash.js",
      "frontwatch.js",
      "appaudio.js",
      "updsplash.js",
      "updatekey.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "2c1e8a76-ec63-5cd5-8636-5e22fa2d2ccf",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Resenha-Setup-${version}.${ext}"
    },
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "Resenha-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "native/lc-input.exe",
        "to": "lc-input.exe"
      },
      {
        "from": "native/lc-stream.exe",
        "to": "lc-stream.exe"
      },
      {
        "from": "native/lc-audio.exe",
        "to": "lc-audio.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
